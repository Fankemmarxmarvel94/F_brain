# .env.example
# Copier ce fichier vers .env et ajuster les valeurs

# ===========================================
# CONFIGURATION GÉNÉRALE
# ===========================================
COMPOSE_PROJECT_NAME=manga_app
ENVIRONMENT=development

# ===========================================
# DJANGO BACKEND
# ===========================================
SECRET_KEY=your-super-secret-key-change-this-in-production
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend

# Base de données
DATABASE_URL=postgresql://manga_user:manga_pass@db:5432/manga_db
POSTGRES_DB=manga_db
POSTGRES_USER=manga_user
POSTGRES_PASSWORD=manga_pass

# Redis (cache et sessions)
REDIS_URL=redis://redis:6379/0

# Email configuration (pour les notifications)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Stockage des fichiers
DEFAULT_FILE_STORAGE=django.core.files.storage.FileSystemStorage
MEDIA_URL=/media/
STATIC_URL=/static/

# API externes (pour récupérer les infos des mangas)
MYANIMELIST_CLIENT_ID=your-mal-client-id
ANILIST_CLIENT_ID=your-anilist-client-id

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME=3600  # 1 heure en secondes
JWT_REFRESH_TOKEN_LIFETIME=604800  # 7 jours en secondes

# ===========================================
# REACT FRONTEND
# ===========================================
REACT_APP_API_URL=http://localhost/api
REACT_APP_ENVIRONMENT=development
REACT_APP_VERSION=1.0.0

# Analytics (optionnel)
REACT_APP_GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX

# ===========================================
# NGINX
# ===========================================
NGINX_PORT=80
NGINX_SSL_PORT=443

# SSL Configuration (pour la production)
SSL_CERTIFICATE_PATH=./nginx/ssl/cert.pem
SSL_PRIVATE_KEY_PATH=./nginx/ssl/key.pem

# ===========================================
# MONITORING ET LOGS
# ===========================================
# Sentry (monitoring d'erreurs)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Niveau de log
LOG_LEVEL=INFO

# ===========================================
# SÉCURITÉ
# ===========================================
# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
CORS_ALLOW_CREDENTIALS=True

# Rate limiting
RATE_LIMIT_API=100/hour
RATE_LIMIT_LOGIN=5/minute

# ===========================================
# DÉVELOPPEMENT
# ===========================================
# Hot reload pour le développement
WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=true

# Ports de développement
BACKEND_DEV_PORT=8000
FRONTEND_DEV_PORT=3000
DB_DEV_PORT=5432
REDIS_DEV_PORT=6379

# ===========================================
# TESTS
# ===========================================
TEST_DATABASE_URL=postgresql://manga_user:manga_pass@db:5432/test_manga_db

# ===========================================
# PRODUCTION
# ===========================================
# Désactiver en production
# DEBUG=0
# ENVIRONMENT=production
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Base de données de production
# DATABASE_URL=postgresql://prod_user:prod_pass@prod_db_host:5432/prod_manga_db

# Redis de production
# REDIS_URL=redis://prod_redis_host:6379/0

# Stockage cloud (AWS S3, etc.)
# DEFAULT_FILE_STORAGE=storages.backends.s3boto3.S3Boto3Storage
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=eu-west-1

# CDN
# STATIC_URL=https://your-cdn.com/static/
# MEDIA_URL=https://your-cdn.com/media/